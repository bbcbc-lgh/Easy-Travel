APP_NAME=EasyTravel
APP_ENV=development
# 只监听本机。改成 0.0.0.0 等于把无鉴权服务暴露到网络，请先阅读 README 的安全说明。
FASTAPI_API_HOST=127.0.0.1
FASTAPI_API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 任意 OpenAI 兼容服务；留空则走规则规划（不调用模型）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_TOTAL_BUDGET_SECONDS=150
LLM_MAX_TOKENS=0
# 推理型模型的思考预算：minimal / low / medium / high；留空 = 服务商默认。
# 实测 deepseek 系：minimal 让同一条 3 天行程 45.6s → 27.9s，评分不变。
# 只在服务商支持 reasoning_effort 时才填，否则请求可能被拒。
LLM_REASONING_EFFORT=minimal

# 可选：多模型回退链。不配置时由上面的 LLM_MODEL 生成单个 profile。
# 按数组顺序尝试，primary 先用，backup 兜底。
# LLM_PROFILES=[{"name":"deepseek-flash","tier":"primary","timeout_seconds":120,"max_tokens":0,"max_retries":2},{"name":"deepseek-v4-pro","tier":"backup","timeout_seconds":180,"max_retries":1}]

# 高德 Web 服务 Key（个人开发者即可申请）
AMAP_WEB_KEY=
USE_SAMPLE_DATA=false

# 和风天气（选填）：配置后优先取预报，失败或日期超出覆盖范围时回退 Open-Meteo
QWEATHER_API_KEY=
# 必须填控制台里给你的“API Host”，形如 abc123.re.qweatherapi.com。
# 老的 devapi.qweather.com 对新 key 会返回 403 Invalid Host。
QWEATHER_HOST=

DATABASE_PATH=data/easy_travel.sqlite3

# 本机成本保护，不是产品配额：只防你自己误点连开把 API 额度烧掉。
# 按浏览器匿名 ID 计；单进程内存计数，重启清零；失败或中断的生成会退还次数。
# 真正兜住花费的是你在模型服务商后台设的额度上限。
PLAN_DAILY_LIMIT=20
PLAN_MAX_CONCURRENCY=2
PLAN_QUEUE_TIMEOUT_SECONDS=8
# 计划被 critic 判定需要重排时，最多再让模型规划几次（0 = 不重排）
PLAN_MAX_REVISIONS=1

# 外部数据缓存（POI / 天气 / 路径）
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600

LOG_LEVEL=INFO
LOG_FORMAT=text
