# EasyTravel — 全项目共用一份配置。
# 复制到仓库根目录再改名：cp .env.example .env
#
#   backend  ← pydantic-settings 读这个文件（backend/src/config.py）
#   frontend ← Vite 通过 envDir 读同一个文件（frontend/vite.config.ts）
#
# 只有 VITE_ 开头的键会被编译进浏览器包，所以放在这里的服务端密钥不会漏到前端。

APP_NAME=EasyTravel
APP_ENV=development
# 只监听本机。改成 0.0.0.0 等于把无鉴权服务暴露到网络，请先阅读 README 的安全说明。
FASTAPI_API_HOST=127.0.0.1
FASTAPI_API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 模型 ----
# 任意 OpenAI 兼容服务；留空则走规则规划（不调用模型）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_TOTAL_BUDGET_SECONDS=150
LLM_MAX_TOKENS=0
# 推理型模型的思考预算：minimal / low / medium / high；留空 = 服务商默认。
# 实测 deepseek 系：minimal 让同一条 3 天行程 45.6s → 27.9s，评分不变。
# 只在服务商支持 reasoning_effort 时才填，否则请求可能被拒。
LLM_REASONING_EFFORT=minimal
# 让服务商按 schema 强制输出结构化 JSON（丢掉「模型返回字段不对」这一整类失败，
# 也不再需要把错误塞回去重问一次）。默认关闭：不支持 json_schema 的服务会直接拒请求，
# 而本项目的承诺是「任意 OpenAI 兼容端点都能用」。确认你的服务支持后再打开。
LLM_JSON_SCHEMA=false

# 可选：多模型回退链。不配置时由上面的 LLM_MODEL 生成单个 profile。
# 按数组顺序尝试，primary 先用，backup 兜底。
# LLM_PROFILES=[{"name":"deepseek-flash","tier":"primary","timeout_seconds":120,"max_tokens":0,"max_retries":2},{"name":"deepseek-v4-pro","tier":"backup","timeout_seconds":180,"max_retries":1}]

# ---- 数据源 ----
# 后端变量统一带 FASTAPI_ 前缀，这样同一个文件里还能放前端的 VITE_* 键而不冲突。
# 高德 Web 服务 Key（个人开发者即可申请）。这是后端查 POI、路线用的 Key。
FASTAPI_AMAP_WEB_KEY=
USE_SAMPLE_DATA=false

# 和风天气（选填）：配置后优先取预报，失败或日期超出覆盖范围时回退 Open-Meteo
FASTAPI_QWEATHER_API_KEY=
# 必须填控制台里给你的“API Host”，形如 abc123.re.qweatherapi.com。
# 老的 devapi.qweather.com 对新 key 会返回 403 Invalid Host。
FASTAPI_QWEATHER_HOST=

DATABASE_PATH=data/easy_travel.sqlite3

# ---- 前端（会被打进浏览器包，别放密钥）----
# 高德 Web端(JS API) Key —— 和上面的 AMAP_WEB_KEY 不是同一个，类型必须选 Web端(JS API)
VITE_AMAP_JS_KEY=
# 这个 JS Key 对应的「安全密钥」。AMap JS API 2.0 必须提供，缺了地图就是空白。
VITE_AMAP_SECURITY_CODE=
# 留空则走同源 /api；前后端分机部署时才需要填
VITE_API_BASE_URL=

# ---- 本地保护 ----
# 本机成本保护，不是产品配额：只防你自己误点连开把 API 额度烧掉。
# 按浏览器匿名 ID 计；单进程内存计数，重启清零；失败或中断的生成会退还次数。
# 真正兜住花费的是你在模型服务商后台设的额度上限。
PLAN_DAILY_LIMIT=20
PLAN_MAX_CONCURRENCY=2
PLAN_QUEUE_TIMEOUT_SECONDS=8
# 计划被 critic 判定需要重排时，最多再让模型规划几次（0 = 不重排）
PLAN_MAX_REVISIONS=1
# 两阶段生成：先只让模型决定「每天去哪几个点」，等行程定稿后再单独生成当天文案。
# 好处：长行程不会因为一次输出太长被截断；文案可以放心写具体地点，不会和裁剪后的行程打架。
# 设为 false 可退回单次调用生成整份行程（旧行为）。
PLAN_TWO_PHASE=true
# 有界检索重试：模型点了候选里没有的地点时，服务端按名字去查一次再问一次。
# 只有「名字找不到」这一种失败会触发，最多 1 轮、最多补 5 个候选，不会无限循环。
PLAN_TOOL_LOOP=true

# 外部数据缓存（POI / 天气 / 路径）
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600

LOG_LEVEL=INFO
LOG_FORMAT=text
